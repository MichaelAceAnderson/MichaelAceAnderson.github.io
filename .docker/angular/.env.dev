NODE_ENV=development
NODE_OPTIONS=--openssl-legacy-provider

# Chemin relatif vers les certificats SSL (relatif au dossier d'exécution de node)
SSL_CRT_FILE=./certs/localhost.crt
SSL_KEY_FILE=./certs/localhost.key

# Activer le rechargement à chaud sur le conteneur
# Ces options forcent le sondage pour le rechargement à chaud
# permettant le développement à la fois localement avec un volume
# et dans le conteneur
WDS_SOCKET_HOST=127.0.0.1
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true