# Standardiser les fins de ligne dans les fichiers pour éviter les conflits de lecture entre Windows et Linux
* text=auto eol=lf

*.conf text eol=lf
*.html text eol=lf
*.ini text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.php text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

*.ico binary
*.png binary
